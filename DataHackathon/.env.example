# عنوان الـ API (تطوير محلي — افتراضي localhost:8000 إن لم تُضبط)
# VITE_API_URL=http://127.0.0.1:8000

# بناء الإنتاج: انسخ إلى .env.production أو عدّل الملف المرفوع .env.production (رابط Render العام)
# VITE_API_URL=https://your-api.onrender.com

# GitHub Pages فقط: hash routing + 404.html يعيد توجيه المسارات (يضبطه workflow تلقائياً)
# VITE_GH_PAGES=true

# إخفاء حقل مفتاح Gemini بالكامل في بناء الإنتاج (حتى لو لم يُضبط المفتاح على الخادم بعد)
# VITE_HIDE_GEMINI_KEY_INPUT=true
