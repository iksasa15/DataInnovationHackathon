# ==========================================
# الحارس الدلالي - إعدادات البيئة
# ==========================================

# تخزين مؤقت لنتيجة /api/gemini-status بالثواني (تقليل طلبات Google عند التجربة المتكررة)
# GEMINI_STATUS_CACHE_SECONDS=90

# --- Google Gemini (للتحليل الذكي لملفات Excel/CSV) ---
# ضع المفتاح هنا عند النشر — المستخدمون لن يحتاجون إدخاله في الواجهة.
GEMINI_API_KEY=your_gemini_api_key_here

# منع إرسال المفتاح من المتصفح (إنتاج) — يبقى فقط GEMINI_API_KEY من الاستضافة
# DISABLE_CLIENT_GEMINI_KEY=true

# --- Supabase: مفتاح Gemini من جدول app_settings (Table Editor) ---
# Project Settings → API → URL و service_role (سري — للخادم فقط)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# اسم الصف في الجدول (اختياري، افتراضي gemini_api_key)
# SUPABASE_GEMINI_SETTING_KEY=gemini_api_key
# مدة تخزين القراءة مؤقتاً بالثواني
# SUPABASE_SETTINGS_CACHE_SECONDS=60

# سر اختياري لمسح الكاش بعد تعديل المفتاح في Supabase:
# POST /api/admin/refresh-supabase-cache  مع الترويسة X-Admin-Secret
# ADMIN_SECRET=ضع_نصاً_عشوائياً_قوياً

# --- OpenAI (الخيار الأول للاستمارة الفردية) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Groq (مجاني وسريع - الخيار البديل) ---
# GROQ_API_KEY=gsk_...

# --- إعدادات الخادم ---
PORT=8000

# للنشر: نطاق الواجهة العامة (مفصولة بفاصلة، بدون مسافة زائدة)
# مثال: ALLOWED_ORIGINS=https://my-app.netlify.app,https://www.example.com
# ALLOWED_ORIGINS=

# --- دفعات Excel الديناميكية (LFS) ---
# أقصى عدد أعمدة يُرسل للنموذج بعد التقليص (افتراضي 96)
# LFS_MAX_COLUMNS=96
# حجم كل دفعة صفوف لـ Gemini
# DYNAMIC_BATCH_SIZE=20
